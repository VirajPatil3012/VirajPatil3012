// scripts/update-readme.js
//
// Fetches all public repos for GITHUB_USERNAME that are tagged with the
// topic "featured", then rewrites the block between
//   <!--START_PROJECTS-->  ...  <!--END_PROJECTS-->
// in README.md with a generated project table.
//
// Requires Node 18+ (built-in fetch). Auth token comes from GITHUB_TOKEN.

const fs = require("fs");

const USERNAME = process.env.GITHUB_USERNAME || "VirajPatil3012";
const TOKEN = process.env.GITHUB_TOKEN;
const README_PATH = "README.md";
const START_MARKER = "<!--START_PROJECTS-->";
const END_MARKER = "<!--END_PROJECTS-->";

async function fetchFeaturedRepos() {
  const perPage = 100;
  let page = 1;
  let allRepos = [];

  while (true) {
    const res = await fetch(
      `https://api.github.com/users/${USERNAME}/repos?per_page=${perPage}&page=${page}&type=owner`,
      {
        headers: {
          Accept: "application/vnd.github+json",
          ...(TOKEN ? { Authorization: `Bearer ${TOKEN}` } : {}),
        },
      }
    );

    if (!res.ok) {
      throw new Error(`GitHub API error: ${res.status} ${await res.text()}`);
    }

    const repos = await res.json();
    if (repos.length === 0) break;

    allRepos = allRepos.concat(repos);
    if (repos.length < perPage) break;
    page += 1;
  }

  // Only repos tagged with the "featured" topic, not forks
  const featured = allRepos.filter(
    (r) => !r.fork && Array.isArray(r.topics) && r.topics.includes("featured")
  );

  // Newest / most recently pushed first
  featured.sort((a, b) => new Date(b.pushed_at) - new Date(a.pushed_at));

  return featured;
}

function buildCard(repo) {
  const desc = repo.description ? repo.description : "No description provided.";
  const lang = repo.language ? `\`${repo.language}\`` : "";
  const homepage = repo.homepage && repo.homepage.trim() !== "" ? repo.homepage.trim() : null;

  return `<td width="50%" valign="top">

### 📦 ${repo.name}

${desc}

${lang}

[![GitHub](https://img.shields.io/badge/Code-181717?style=flat-square&logo=github&logoColor=white)](${repo.html_url})
${homepage ? `[![Demo](https://img.shields.io/badge/Live%20Demo-38BDF8?style=flat-square&logo=vercel&logoColor=white)](${homepage})` : ""}

</td>`;
}

function buildProjectsBlock(repos) {
  if (repos.length === 0) {
    return "\n_No repos tagged with the `featured` topic yet. Add the topic \"featured\" to a repo on GitHub to have it show up here._\n";
  }

  const rows = [];
  for (let i = 0; i < repos.length; i += 2) {
    const pair = repos.slice(i, i + 2).map(buildCard);
    rows.push(`<tr>\n${pair.join("\n")}\n</tr>`);
  }

  return `\n<table width="100%">\n${rows.join("\n")}\n</table>\n`;
}

async function main() {
  const readme = fs.readFileSync(README_PATH, "utf8");

  const startIdx = readme.indexOf(START_MARKER);
  const endIdx = readme.indexOf(END_MARKER);

  if (startIdx === -1 || endIdx === -1) {
    throw new Error(
      `Could not find ${START_MARKER} / ${END_MARKER} markers in ${README_PATH}`
    );
  }

  const repos = await fetchFeaturedRepos();
  const block = buildProjectsBlock(repos);

  const before = readme.slice(0, startIdx + START_MARKER.length);
  const after = readme.slice(endIdx);

  const updated = `${before}\n${block}\n${after}`;

  fs.writeFileSync(README_PATH, updated, "utf8");
  console.log(`Updated README with ${repos.length} featured repo(s).`);
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
